// Woomp Plugin Entity Relationship Model
// 基於 WordPress/WooCommerce 資料結構
// 生成日期：2026-03-15

Project woomp {
  database_type: 'MySQL'
  Note: 'WooCommerce 好用版擴充 - 資料模型'
}

// ============================================================
// WordPress / WooCommerce 核心資料表（參考用）
// ============================================================

Table wc_orders [note: 'WooCommerce 訂單（HPOS）'] {
  id bigint [pk, increment, note: '訂單 ID']
  status varchar [note: '訂單狀態']
  type varchar [note: '訂單類型（shop_order / shop_subscription）']
  payment_method varchar [note: '付款方式 ID']
  customer_id bigint [note: '顧客 ID']
  total decimal [note: '訂單總金額']
  date_created_gmt datetime
  date_updated_gmt datetime
}

Table wc_orders_meta [note: 'WooCommerce 訂單 Meta（HPOS）'] {
  id bigint [pk, increment]
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']
  meta_key varchar [note: 'Meta Key']
  meta_value longtext [note: 'Meta Value']
}

Table wp_options [note: 'WordPress 選項表'] {
  option_id bigint [pk, increment]
  option_name varchar [unique, note: '選項名稱']
  option_value longtext [note: '選項值']
  autoload varchar [note: '是否自動載入']
}

Table wc_payment_tokens [note: 'WooCommerce 付款 Token'] {
  token_id bigint [pk, increment]
  gateway_id varchar [note: '閘道 ID']
  token varchar [note: 'Token 值（CreditHash 或卡號組合）']
  user_id bigint [note: '使用者 ID']
  type varchar [note: 'Token 類型（CC）']
  is_default tinyint [note: '是否為預設']
}

Table wc_payment_tokenmeta [note: 'WooCommerce 付款 Token Meta'] {
  meta_id bigint [pk, increment]
  payment_token_id bigint [ref: > wc_payment_tokens.token_id]
  meta_key varchar
  meta_value longtext

  Note: '''
    PayUni Token Meta：
    - card_type: visa/mastercard/amex/discover
    - last4: 卡號末四碼
    - expiry_month: 有效月份
    - expiry_year: 有效年份
  '''
}

// ============================================================
// 模組啟用設定（wp_options）
// ============================================================

Table wp_options_module_activation [note: 'Woomp 模組啟用/停用設定'] {
  option_name varchar [pk]
  option_value varchar [note: 'yes/no']

  Note: '''
    控制各金流/物流/發票模組的啟停。
    以下為所有模組啟用選項：
  '''
}

// --- 模組啟用選項列表 ---
// wc_woomp_enabled_payuni_gateway     | 統一金流 PAYUNi 金流
// wc_woomp_enabled_payuni_shipping    | 統一金流 PAYUNi 物流（目前停用）
// ry_wt_enabled_ecpay_gateway         | 綠界金流（RY_WT::$option_prefix = 'ry_wt_'）
// ry_wt_enabled_ecpay_shipping        | 綠界物流
// ry_wt_enabled_newebpay_gateway      | 藍新金流
// ry_wt_enabled_newebpay_shipping     | 藍新物流
// ry_wt_enabled_smilepay_gateway      | 速買配金流
// ry_wt_enabled_smilepay_shipping     | 速買配物流
// wc_woomp_setting_paynow_gateway     | 立吉富金流
// wc_woomp_setting_paynow_shipping    | 立吉富物流
// wc_settings_tab_active_paynow_einvoice | 立吉富電子發票
// woocommerce_linepay_enabled         | LINE Pay 金流
// woocommerce_pchomepay_enabled       | 支付連金流
// wc_woomp_enabled_ecpay_invoice      | 綠界電子發票（好用版）
// wc_woomp_enabled_ezpay_invoice      | 藍新 ezPay 電子發票

// ============================================================
// PayUni 金流設定（wp_options）
// ============================================================

Table wp_options_payuni [note: 'PayUni 統一金流設定選項'] {
  option_name varchar [pk]
  option_value varchar

  Note: '''
    PayUni 金流 API 憑證與功能設定
  '''
}

// --- PayUni 選項列表 ---
// payuni_payment_testmode             | 測試模式（yes/no）
// payuni_payment_log                  | 除錯日誌（yes/no）
// payuni_3d_auth                      | 3D 驗證（yes/no）
// payuni_payment_merchant_no_test     | 測試商店代號
// payuni_payment_hash_key_test        | 測試 HashKey
// payuni_payment_hash_iv_test         | 測試 HashIV
// payuni_payment_merchant_no          | 正式商店代號
// payuni_payment_hash_key             | 正式 HashKey
// payuni_payment_hash_iv              | 正式 HashIV
// payuni_shipping_testmode            | 物流測試模式
// payuni_shipping_MerchantID          | 物流商店代號
// payuni_shipping_HashKey             | 物流 HashKey
// payuni_shipping_HashIV              | 物流 HashIV
// payuni_shipping_log                 | 物流日誌
// payuni_shipping_order_prefix        | 物流訂單前綴
// payuni_shipping_sender_name         | 寄件人姓名
// payuni_shipping_sender_phone        | 寄件人電話
// payuni_shipping_sender_cellphone    | 寄件人手機
// payuni_shipping_sender_zipcode      | 寄件人郵遞區號
// payuni_shipping_sender_address      | 寄件人地址

// ============================================================
// ECPay 金流/物流設定（wp_options，前綴 ry_wt_）
// ============================================================

Table wp_options_ecpay [note: '綠界金流/物流設定選項（RY_WT 前綴）'] {
  option_name varchar [pk]
  option_value varchar

  Note: '''
    綠界 API 憑證與設定，選項前綴為 ry_wt_
    詳細選項由 settings-ecpay-gateway.php 和
    settings-ecpay-shipping.php 定義
  '''
}

// --- ECPay 金流選項列表（前綴 ry_wt_） ---
// ry_wt_ecpay_gateway_testmode        | 測試模式
// ry_wt_ecpay_gateway_MerchantID      | 商店代號
// ry_wt_ecpay_gateway_HashKey         | HashKey
// ry_wt_ecpay_gateway_HashIV          | HashIV
// ry_wt_ecpay_gateway_order_prefix    | 訂單編號前綴
// ry_wt_repay_action                  | 重新付款功能
// ry_wt_strength_password             | 密碼強度驗證
// ry_wt_show_unpay_title              | 顯示未付款資訊
// ry_wt_show_country_select           | 顯示國家選單
// ry_wt_last_name_first               | 姓氏在前
// ry_wt_address_zip_first             | 郵遞區號在前

// ============================================================
// NewebPay 藍新設定（wp_options）
// ============================================================

Table wp_options_newebpay [note: '藍新金流設定選項'] {
  option_name varchar [pk]
  option_value varchar

  Note: '''
    藍新金流 API 憑證與設定，選項前綴為 ry_wt_
  '''
}

// --- NewebPay 選項列表（前綴 ry_wt_） ---
// ry_wt_newebpay_gateway_testmode     | 測試模式
// ry_wt_newebpay_gateway_MerchantID   | 商店代號
// ry_wt_newebpay_gateway_HashKey      | HashKey
// ry_wt_newebpay_gateway_HashIV       | HashIV

// ============================================================
// PayNow 立吉富設定（wp_options）
// ============================================================

Table wp_options_paynow [note: '立吉富金流/物流/發票設定選項'] {
  option_name varchar [pk]
  option_value varchar

  Note: '''
    立吉富 API 憑證與設定
  '''
}

// --- PayNow 金流選項 ---
// paynow_payment_testmode_enabled     | 測試模式
// paynow_payment_debug_log_enabled    | 除錯日誌
// paynow_payment_web_no               | WebNo
// paynow_payment_trans_pwd            | 交易密碼
// paynow_payment_merchant_name        | 商家名稱

// --- PayNow 物流選項 ---
// paynow_shipping_testmode_enabled    | 測試模式
