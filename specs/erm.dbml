// ============================================================
// Woomp 結帳/商品設定（wp_options）
// ============================================================

Table wp_options_woomp_general [note: 'Woomp 一般設定選項'] {
  option_name varchar [pk]
  option_value varchar
}

// --- 結帳相關 ---
// wc_woomp_setting_mode                     | 結帳流程（default/onepage/twopage）
// wc_woomp_setting_mode_twopage_message     | 兩頁式返回購物車文字
// wc_woomp_setting_billing_country_pos      | 國家欄位置頂
// wc_woomp_setting_tw_address               | 台灣地址下拉
// wc_woomp_setting_one_line_address         | 訂單地址整併
// wc_woomp_setting_show_phone               | 顯示電話資訊
// wc_woomp_setting_tw_field_valitdate       | 姓名電話驗證
// wc_woomp_setting_virtual_product_address  | 虛擬商品隱藏地址
// wc_woomp_setting_cod_payment              | 取代貨到付款
// wc_woomp_setting_place_order_text         | 結帳按鈕文字
// wc_woomp_setting_free_shipping_hint       | 免運提示
// wc_woomp_setting_free_shipping_text_left  | 免運提示文字
// wc_woomp_setting_free_shipping_text_free_shipping | 已達免運文字
// wc_woomp_setting_free_shipping_bg_color   | 免運提示背景色
// wc_woomp_setting_free_shipping_text_color | 免運提示文字色

// --- 商品相關 ---
// wc_woomp_setting_product_variations_ui               | 可變商品後台介面
// wc_woomp_setting_product_variations_frontend_ui      | 可變商品前台介面
// wc_woomp_setting_product_variations_frontend_ui＿default  | 預設標籤式
// wc_woomp_setting_product_variations_frontend_ui＿bg_color | 標籤背景色
// wc_woomp_setting_product_variations_frontend_ui＿text_color | 標籤文字色
// wc_woomp_setting_virtual_product_order_auto_complete  | 虛擬商品自動完成

// ============================================================
// 訂單 Meta — PayUni 金流
// ============================================================

Table order_meta_payuni [note: 'PayUni 統一金流訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']

  // --- v1 + v3 共用回應 Meta ---
  _payuni_resp_status varchar [note: '交易狀態（SUCCESS/錯誤碼）']
  _payuni_resp_message varchar [note: '交易訊息']
  _payuni_resp_trade_no varchar [note: 'PAYUNi 交易編號']
  _payuni_card_number varchar [note: '卡號末四碼']

  // --- v1 信用卡專用 ---
  _payuni_resp_card_bank varchar [note: '發卡銀行（代碼+名稱）']
  _payuni_resp_card_inst varchar [note: '分期期數']
  _payuni_resp_first_amt varchar [note: '首期金額']
  _payuni_resp_each_amt varchar [note: '每期金額']
  _payuni_order_suffix int [note: '訂單流水號後綴（用於重送）']
  _payuni_token_maybe_save varchar [note: '是否儲存卡片（yes/no，v1）']
  _payuni_is_3d_auth varchar [note: '是否走 3D 驗證（yes/no，v1）']
  _payuni_token_id varchar [note: '使用的 Token ID']
  _payuni_card_hash varchar [note: '信用卡 Hash（已棄用，改存 wc_payment_tokens）']

  // --- v1 ATM 專用 ---
  _payuni_resp_bank varchar [note: '轉帳銀行（代碼+名稱）']
  _payuni_resp_bank_no varchar [note: '轉帳帳號']
  _payuni_resp_bank_expire varchar [note: '轉帳期限']

  // --- v3 專用 ---
  _payuni_v3_resp text [note: 'v3 完整交易回應（序列化陣列）']

  // --- v3 暫存資料（交易完成後刪除） ---
  sdk_token_tmp varchar [note: 'SDK Token 暫存']
  payuni_save_card varchar [note: '是否儲存卡片（yes/no）']
  payuni_installment varchar [note: '分期期數']
  payuni_use_saved_token varchar [note: '是否使用已存卡片（yes/no）']
  payuni_saved_token_id varchar [note: '已存卡片 Token ID']
  payuni_carrier_type varchar [note: '發票載具類型']
  payuni_carrier_info varchar [note: '發票載具編號']
  payuni_inv_buyer_name varchar [note: '發票買受人名稱']

  Note: '''
    PayUni v1（PAYUNI\Gateways\Response）與 v3（J7\Payuni\Infrastructure\Http\TradeHandler）
    共用 _payuni_resp_* 前綴。v3 額外儲存 _payuni_v3_resp 完整回應。
    暫存資料（sdk_token_tmp 等）在交易完成後由 OrderUtils::delete_tmp_data() 清除。
  '''
}

// ============================================================
// 訂單 Meta — ECPay 金流
// ============================================================

Table order_meta_ecpay_payment [note: '綠界金流訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]

  // --- ATM 虛擬帳號 ---
  _ecpay_atm_BankCode varchar [note: '轉帳銀行代碼']
  _ecpay_atm_vAccount varchar [note: '虛擬帳號']
  _ecpay_atm_ExpireDate varchar [note: '繳費期限']

  // --- 超商代碼（CVS） ---
  _ecpay_cvs_PaymentNo varchar [note: '超商繳費代碼']
  _ecpay_cvs_ExpireDate varchar [note: '超商繳費期限']

  // --- 超商條碼（Barcode） ---
  _ecpay_barcode_Barcode1 varchar [note: '條碼一']
  _ecpay_barcode_Barcode2 varchar [note: '條碼二']
  _ecpay_barcode_Barcode3 varchar [note: '條碼三']
  _ecpay_barcode_ExpireDate varchar [note: '條碼繳費期限']

  Note: '由 ry-woocommerce-tools 綠界金流模組寫入'
}

// ============================================================
// 訂單 Meta — ECPay 物流
// ============================================================

Table order_meta_ecpay_shipping [note: '綠界物流訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]
  _ecpay_shipping_info text [note: '物流資訊陣列（序列化），包含每筆託運單的 BookingNote、LogisticsType、RtnCode 等']
  _shipping_cvs_store_ID varchar [note: '超商門市編號']
  _shipping_cvs_store_name varchar [note: '超商門市名稱']
  _shipping_cvs_store_address varchar [note: '超商門市地址']

  Note: '''
    _ecpay_shipping_info 為序列化陣列，每筆託運單包含：
    BookingNote（託運單號）、LogisticsType（物流類型）、
    RtnCode（物流狀態碼）、CreateDate（建立日期）等
  '''
}

// ============================================================
// 訂單 Meta — SmilePay 物流
// ============================================================

Table order_meta_smilepay_shipping [note: '速買配物流訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]
  _smilepay_shipping_info text [note: '物流資訊陣列（序列化）']
  _shipping_cvs_store_ID varchar [note: '超商門市編號']
  _shipping_cvs_store_name varchar [note: '超商門市名稱']
  _shipping_cvs_store_address varchar [note: '超商門市地址']
  _shipping_phone varchar [note: '收件人電話']

  Note: '由 ry-woocommerce-tools 速買配物流模組寫入'
}

// ============================================================
// 訂單 Meta — PayNow 金流
// ============================================================

Table order_meta_paynow_payment [note: '立吉富金流訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]

  Note: '''
    立吉富金流透過 PayNow API 處理，
    訂單狀態直接由 WooCommerce 管理。
    無額外自訂 meta key。
  '''
}

// ============================================================
// 訂單 Meta — PayNow 物流
// ============================================================

Table order_meta_paynow_shipping [note: '立吉富物流訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]
  _paynow_shipping_logistic_service_id varchar [note: '物流服務 ID（711/FAMI/HILIFE/TCAT）']
  _paynow_shipping_logistic_service varchar [note: '物流服務名稱']
  _paynow_shipping_logistic_sno varchar [note: '物流單序號']
  _shipping_paynow_storeid varchar [note: '超商門市編號']
  _shipping_paynow_storename varchar [note: '超商門市名稱']
  _shipping_paynow_storeaddress varchar [note: '超商門市地址']
  _shipping_paynow_reservedno varchar [note: '保留編號（全家冷凍）']
  _shipping_paynow_shipdate varchar [note: '預計運送時間']
  _paynow_shipping_delivery_type varchar [note: '溫層類型（黑貓：常溫/冷藏/冷凍）']
  _paynow_shipping_logistic_number varchar [note: 'PayNow 物流單號']
  _paynow_shipping_paymentno varchar [note: '物流商託運單號']
  _paynow_shipping_validation_no varchar [note: '物流商驗證碼（搭配 ibon 列印）']
  _paynow_shipping_status varchar [note: '訂單狀態（0=成立中/1=無效）']
  _paynow_shipping_paynoworderno varchar [note: '重新取號後 PayNow 訂單編號']
  _paynow_shipping_delivery_status varchar [note: '物流配送狀態']
  _paynow_shipping_logistic_code varchar [note: 'PayNow 物流代碼']
  _paynow_shipping_detail_status_desc varchar [note: '物流代碼描述']
  _paynow_shipping_return_msg varchar [note: '回傳訊息']
  _paynow_shipping_error_msg varchar [note: '錯誤訊息']
  _paynow_shipping_status_update_at varchar [note: '狀態更新時間']
  _paynow_shipping_store_date varchar [note: '到店日期']
  _paynow_shipping_store_time varchar [note: '到店時間']

  Note: '''
    Meta key 定義於 class-paynow-shipping-order-meta.php
    (PayNow_Shipping_Order_Meta 常數類別)
  '''
}

// ============================================================
// 訂單 Meta — LINE Pay
// ============================================================

Table order_meta_linepay [note: 'LINE Pay 訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]
  _linepay_payment_status varchar [note: 'LINE Pay 付款狀態']

  Note: '由 line-pay-for-woo 模組寫入'
}

// ============================================================
// 訂單 Meta — PChomePay 支付連
// ============================================================

Table order_meta_pchomepay [note: '支付連訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]
  _pchomepay_orderid varchar [note: '支付連訂單 ID']
  _pchomepay_paytype varchar [note: '付款方式（CARD/ATM/EACH/ACCT/IPL7）']
  _pchomepay_refundid varchar [note: '退款 ID（多筆以逗號分隔）']
  _pchomepay_refund_url varchar [note: '退款 URL']
  _pchomepay_logisticid varchar [note: '支付連物流 ID（7-11 取貨）']

  Note: '由 PChomePay-Cart-for-WooCommerce 模組寫入'
}

// ============================================================
// 訂單 Meta — ECPay 電子發票
// ============================================================

Table order_meta_ecpay_invoice [note: '綠界電子發票訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]
  _ecpay_invoice_data text [note: '發票資料（序列化陣列）']
  _ecpay_invoice_number varchar [note: '發票號碼']
  _ecpay_invoice_status varchar [note: '發票狀態（0=未開/1=已開）']

  Note: '''
    _ecpay_invoice_data 陣列包含：
    - _invoice_type: 發票類型（personal/company/donate）
    - _invoice_individual: 載具類型（雲端發票/手機條碼/自然人憑證/紙本發票）
    - _invoice_carrier: 載具編號
    - _invoice_company_name: 公司名稱
    - _invoice_tax_id: 統一編號
    - _invoice_donate: 捐贈碼

    舊格式相容：
    - _invoice_type / _invoice_carruer_type / _invoice_carruer_no
    - _invoice_no / _invoice_donate_no
    在 Admin.php 中自動遷移至新格式 _ecpay_invoice_data
  '''
}

// ============================================================
// 訂單 Meta — EZPay 電子發票
// ============================================================

Table order_meta_ezpay_invoice [note: 'ezPay 藍新電子發票訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]
  _ezpay_invoice_data text [note: '發票資料（序列化陣列）']
  _ezpay_invoice_number varchar [note: '發票號碼']
  _ezpay_invoice_status varchar [note: '發票狀態（0=未開/1=已開）']
  _ezpay_invoice_result text [note: '開立結果（成功時為結果資料，失敗時為錯誤訊息）']

  Note: '''
    _ezpay_invoice_data 陣列結構同 ECPay，包含：
    _invoice_type, _invoice_individual, _invoice_carrier,
    _invoice_company_name, _invoice_tax_id, _invoice_donate
  '''
}

// ============================================================
// 訂單 Meta — PayNow 電子發票
// ============================================================

Table order_meta_paynow_invoice [note: '立吉富電子發票訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]
  _paynow_ei_issued varchar [note: '是否已開立（yes/no）']
  _paynow_ei_result_invoice_number varchar [note: '發票號碼']
  _paynow_ei_issue_type varchar [note: '開立類型（personal/company/donate）']
  _paynow_ei_ubn varchar [note: '統一編號']
  _paynow_ei_buyer_name varchar [note: '買受人名稱']
  _paynow_ei_carrier_type varchar [note: '載具類型（cloud/mobile_code/cdc/easycard）']
  _paynow_ei_carrier_num varchar [note: '載具編號']
  _paynow_ei_donate_org varchar [note: '捐贈機構愛心碼']
  _paynow_invoice_url varchar [note: '發票查詢 URL']

  Note: '由 paynow-einvoice 模組寫入'
}

// ============================================================
// 訂單 Meta — Woomp 通用
// ============================================================

Table order_meta_woomp [note: 'Woomp 通用訂單 Meta'] {
  order_id bigint [ref: > wc_orders.id]
  wmp_shipping_no varchar [note: '自訂物流追蹤編號（跨服務商通用）']
  _billing_full_address varchar [note: '帳單完整地址（整併後，key: _billing_full-address）']
  _shipping_full_addressShipping varchar [note: '運送完整地址（整併後）']

  Note: '由 Woomp 核心模組寫入，跨服務商通用'
}

// ============================================================
// 商品 Meta
// ============================================================

Table product_meta_woomp [note: 'Woomp 商品 Meta'] {
  product_id bigint [note: '商品/文章 ID']
  _onepagecheckout varchar [note: '啟用一頁式結帳（yes/no）']
  _is_active_woomp_ui varchar [note: '啟用好用版規格 UI（yes/no）']
  attribute_name_type varchar [note: '屬性顯示類型（attribute_{name}_type）']

  Note: '''
    - _onepagecheckout: 單一商品層級的一頁式結帳控制
    - _is_active_woomp_ui: 單一商品層級的好用版規格 UI 控制
    - attribute_{name}_type: 屬性的前台顯示方式（顏色/圖片/標籤等）
  '''
}

// ============================================================
// 訂閱 Meta
// ============================================================

Table subscription_meta_invoice [note: '訂閱發票 Meta'] {
  subscription_id bigint [note: '訂閱 ID（WC_Subscription）']
  _paynow_ei_issue_type varchar [note: '發票類型']
  _paynow_ei_carrier_type varchar [note: '載具類型']
  _paynow_ei_carrier_num varchar [note: '載具編號']
  _paynow_ei_ubn varchar [note: '統一編號']
  _paynow_ei_buyer_name varchar [note: '買受人名稱']
  _paynow_ei_donate_org varchar [note: '捐贈機構愛心碼']

  Note: '''
    訂閱的發票資訊透過 shop_subscription 的 invoice-management
    模組管理，續約時複製至新訂單。
    定義於 admin/resources/shop_subscription/invoice-management/
  '''
}

// ============================================================
// Transient 快取
// ============================================================

Table wp_transients_woomp [note: 'Woomp Transient 快取'] {
  transient_key varchar [pk, note: 'Transient Key']
  transient_value longtext [note: 'Transient Value']
  expiration int [note: '過期時間（秒）']

  Note: '''
    使用的 Transient：
    - woomp_temp_{user_id}: 結帳頁自動儲存的使用者填寫資料
      有效期：12 小時
      寫入：transient.php → myajax_ajax_handler()
      讀取：transient.php → myajax_ajax_handler_2()
  '''
}

// ============================================================
// Relationships
// ============================================================

// PayUni 金流 → 訂單
Ref: order_meta_payuni.order_id > wc_orders.id

// ECPay 金流 → 訂單
Ref: order_meta_ecpay_payment.order_id > wc_orders.id

// ECPay 物流 → 訂單
Ref: order_meta_ecpay_shipping.order_id > wc_orders.id

// SmilePay 物流 → 訂單
Ref: order_meta_smilepay_shipping.order_id > wc_orders.id

// PayNow 物流 → 訂單
Ref: order_meta_paynow_shipping.order_id > wc_orders.id

// LINE Pay → 訂單
Ref: order_meta_linepay.order_id > wc_orders.id

// PChomePay → 訂單
Ref: order_meta_pchomepay.order_id > wc_orders.id

// ECPay 發票 → 訂單
Ref: order_meta_ecpay_invoice.order_id > wc_orders.id

// EZPay 發票 → 訂單
Ref: order_meta_ezpay_invoice.order_id > wc_orders.id

// PayNow 發票 → 訂單
Ref: order_meta_paynow_invoice.order_id > wc_orders.id

// Woomp 通用 → 訂單
Ref: order_meta_woomp.order_id > wc_orders.id

// Payment Token → 使用者
// (wc_payment_tokens.user_id > wp_users.ID)
// PayUni gateway_id: 'payuni-credit-subscription'（v1）或 'payuni-credit-v3'（v3）
