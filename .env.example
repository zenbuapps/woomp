# ══════════════════════════════════════════════
# Woomp 測試環境設定
# 複製此檔為 .env 並填入正確值
# ══════════════════════════════════════════════

# ── 測試站台 ──────────────────────────────────
# wp-env（localhost:8888）+ Cloudflare Named Tunnel 對外公開
TEST_SITE_URL=https://local-test.powerhouse.tw

# ── WordPress 管理員帳號 ────────────────────────
# wp-env 預設帳密
TEST_USERNAME=admin
TEST_PASSWORD=password

# ── CI 模式 ────────────────────────────────────
# true = headless（無視窗），false = 有頭模式（本地 debug 用）
CI=false

# ── WooCommerce REST API Keys ──────────────────
# 由 seed script 自動產生並寫入，初始可留空
WC_API_KEY=
WC_API_SECRET=

# ── PayUni Sandbox 憑證（wp-env seed script 用）──
# seed script 會將這些值注入到 WordPress options
PAYUNI_MERCHANT_ID=
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=

# ── 動態商品 ID（wp-env seed script 產生）───────
# seed script 建立商品後會自動寫回此處
PRODUCT_ID=
PRODUCT_INSTALLMENT_ID=
