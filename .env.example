# ══════════════════════════════════════════════
# Woomp 測試環境設定
# 複製此檔為 .env 並填入正確值
# ══════════════════════════════════════════════

# ── 測試站台 ──────────────────────────────────
# E2E 測試的目標網站 URL
#
# LocalWP 環境：使用 Cloudflare Tunnel 對外公開
#   TEST_SITE_URL=https://local-turbo.powerhouse.tw
#
# wp-env 環境：使用 Named Tunnel 指向 localhost:8888
#   TEST_SITE_URL=https://woomp-test.powerhouse.tw
#
TEST_SITE_URL=https://your-test-site.example.com

# ── WordPress 管理員帳號 ────────────────────────
# LocalWP：自訂帳密
# wp-env：預設 admin / password
TEST_USERNAME=your_username
TEST_PASSWORD=your_password

# ── CI 模式 ────────────────────────────────────
# true = headless（無視窗），false = 有頭模式（本地 debug 用）
CI=false

# ── WooCommerce REST API Keys ──────────────────
# 由 00-setup 測試或 seed script 自動產生並寫入，初始可留空
WC_API_KEY=
WC_API_SECRET=

# ── PayUni Sandbox 憑證（wp-env seed script 用）──
# seed script 會將這些值注入到 WordPress options
# LocalWP 環境已在後台設定，可留空
PAYUNI_MERCHANT_ID=
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=

# ── 動態商品 ID（wp-env seed script 產生）───────
# seed script 建立商品後會自動寫回此處
# LocalWP 環境使用 hardcoded 預設值（81 / 1028），可留空
PRODUCT_ID=
PRODUCT_INSTALLMENT_ID=
