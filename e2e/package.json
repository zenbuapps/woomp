{
  "name": "woomp-e2e",
  "version": "1.0.0",
  "description": "PayUni v3 E2E Playwright 測試腳本",
  "scripts": {
    "test": "playwright test",
    "test:invoice": "playwright test payuni-invoice-carrier.ts",
    "test:tokenization": "playwright test payuni-tokenization.ts",
    "test:checkout": "npx tsx payuni-checkout.ts",
    "test:installment": "npx tsx payuni-installment.ts",
    "test:checkout:cdp": "npx tsx payuni-checkout.ts --cdp-endpoint=http://localhost:9222"
  },
  "dependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
